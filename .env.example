# Copia in .env e compila. Il file .env non va MAI nel repository.

AMBIENTE=sviluppo
LOG_LEVEL=INFO
FUSO_ORARIO=Europe/Rome

# Database (usati da docker-compose per creare il db e comporre DATABASE_URL)
POSTGRES_USER=europrojecta
POSTGRES_PASSWORD=cambiami
POSTGRES_DB=europrojecta

# Per eseguire l'app fuori da Docker (uv run ...), con il db esposto su localhost:
DATABASE_URL=postgresql+psycopg://europrojecta:cambiami@127.0.0.1:5432/europrojecta

# Almeno 32 caratteri casuali:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Cookie di sessione solo su HTTPS. In produzione SEMPRE true (Caddy fornisce l'HTTPS);
# false solo in sviluppo su http://127.0.0.1.
COOKIE_SECURE=false
# Verifica in due passaggi (app di autenticazione): false = basta la password (sconsigliato)
# VERIFICA_DUE_PASSAGGI=true
SESSIONE_INATTIVITA_MINUTI=60
SESSIONE_DURATA_MAX_ORE=12

# Chiavi delle integrazioni: si configurano dall'app (Impostazioni -> Integrazioni),
# cifrate nel database. In alternativa si possono dare qui; il valore nel database prevale.
# OPENAI_API_KEY=
# SMTP_HOST=
# SMTP_PORTA=587
# SMTP_SICUREZZA=starttls
# SMTP_UTENTE=
# SMTP_PASSWORD=
# SMTP_MITTENTE=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_ACCESS_TOKEN=

# Solo per i test di integrazione: database "di servizio" da cui creare i db temporanei
TEST_DATABASE_URL=postgresql+psycopg://europrojecta:cambiami@127.0.0.1:5432/postgres

# Registro Imprese (Openapi): meglio inserire il token da Impostazioni → Integrazioni
# OPENAPI_COMPANY_TOKEN=

# Allegati delle pratiche (in Docker: volume "allegati") e orari dei job
# CARTELLA_ALLEGATI=dati/allegati
# ALLEGATO_MAX_MB=20
# PROMEMORIA_ORARIO=07:30
# APPALTI_ORARIO=03:15
# OPPORTUNITA_ORARIO=07:00
# ESTRAZIONE_ORARIO=04:30
# DOCUMENTI_ORARIO=04:05
# DOCUMENTI_ORARIO=04:05

# --- Produzione (docker-compose.prod.yml, vedi docs/messa-in-produzione.md) ---
# DOMINIO=studio.esempio.it
# EMAIL_CERTIFICATI=
# BACKUP_PASSPHRASE=
# BACKUP_ORARIO=01:30
# Storage esterno dei backup (restic): es. s3:https://s3.eu-central-1.amazonaws.com/bucket, b2:bucket:percorso, sftp:utente@host:/percorso
# RESTIC_REPOSITORY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# Indirizzo pubblico dell'app (link nelle email)
# URL_PUBBLICO=https://studio.esempio.it
# WhatsApp: nome del modello approvato da Meta
# WHATSAPP_NOME_MODELLO=
# Antivirus (in produzione lo imposta il compose): vuoto = nessun controllo
# CLAMAV_HOST=
# CLAMAV_PORTA=3310
# Rotazione della chiave: le vecchie SECRET_KEY separate da virgola
# SECRET_KEY_PRECEDENTI=
