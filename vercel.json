{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "functions": {
    "app/main.py": { "maxDuration": 300 }
  },
  "buildCommand": "if [ -n \"$DATABASE_URL_UNPOOLED\" ]; then DATABASE_URL=\"$DATABASE_URL_UNPOOLED\" uv run --frozen --no-dev alembic upgrade head; else echo 'Nessun database collegato: migrazioni saltate'; fi",
  "crons": [
    { "path": "/cron/raccolta-bandi", "schedule": "30 0 * * *" },
    { "path": "/cron/raccolta-appalti", "schedule": "30 1 * * *" },
    { "path": "/cron/documenti-bandi", "schedule": "30 2 * * *" },
    { "path": "/cron/estrazione-bandi", "schedule": "30 3 * * *" },
    { "path": "/cron/pulizia", "schedule": "30 4 * * *" },
    { "path": "/cron/opportunita", "schedule": "30 5 * * *" },
    { "path": "/cron/promemoria", "schedule": "30 6 * * *" },
    { "path": "/cron/riferimenti-istat", "schedule": "40 2 1 * *" }
  ]
}
